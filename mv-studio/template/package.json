{
  "name": "mv-studio-project",
  "version": "0.1.0",
  "private": true,
  "description": "A lyric MV project made with the mv-studio skill (based on vocaloid-style-mv-pipeline by NikusonP): deterministic Canvas2D/WebGL2 engine with styles (vocaloid / interface / stage / papercraft), rendered headless with Playwright and ffmpeg.",
  "author": "NikusonP",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node -e \"const w=process.platform==='win32';const r=require('node:child_process').spawnSync(w?'powershell':'bash',w?['-NoProfile','-ExecutionPolicy','Bypass','-File','setup.ps1']:['setup.sh'],{stdio:'inherit'});process.exit(r.status===null?1:r.status)\"",
    "check": "python tools/check_env.py",
    "env": "node tools/kit_env.mjs",
    "pip": "python -m pip install -r requirements.txt",
    "fonts": "python tools/fetch_fonts.py",
    "browser:install": "playwright install chromium",
    "jizura:clone": "node -e \"const g=a=>{const r=require('node:child_process').spawnSync('git',a,{stdio:'inherit'});if(r.status!==0)process.exit(r.status===null?1:r.status)};const d=process.env.JIZURA_DIR||'vendor/JIZURA',ref=process.env.JIZURA_REF||'fc16bfe43ea4a6c25a21f1caf04d17326de14f00';console.log('JIZURA @ '+ref+' -> '+d);g(['init','-q',d]);g(['-C',d,'config','remote.origin.url','https://github.com/852wa/JIZURA']);g(['-C',d,'fetch','--depth','1','origin',ref]);g(['-C',d,'checkout','-q','--detach','FETCH_HEAD'])\"",
    "jizura:build": "node tools/build_jizura_bundle.mjs",
    "demo:song": "python demo/make_demo_song.py",
    "analyze": "python tools/analyze_audio.py",
    "cues": "python tools/make_cues.py",
    "measure:cues": "python tools/measure_cues.py",
    "stills": "node tools/stills.mjs",
    "preview": "node tools/jizura_serve.mjs 5179",
    "render": "node tools/render_final.mjs --name mv",
    "render:preview": "node tools/render_final.mjs --name preview --preview",
    "render:vertical": "node tools/render_final.mjs --name mv_vertical --url engine/vertical.html --selector canvas#vout --width 1080 --height 1920",
    "lyrics:estimate": "python tools/estimate_lrc.py",
    "lyrics:status": "python tools/lyric_timing.py status",
    "lyrics:editor": "node tools/lyric_editor/server.mjs",
    "lyrics:score": "python tools/score_timing.py",
    "art:providers": "python tools/artgen.py providers",
    "art": "python tools/artgen.py run",
    "art:collect": "python tools/artgen.py collect",
    "art:grok:plan": "python tools/grokgen.py plan",
    "art:grok:collect": "python tools/grokgen.py collect",
    "check:flash": "python tools/check_flash.py render/mv.mp4",
    "preroll": "python tools/preroll.py render/mv.mp4",
    "lineup": "python tools/lineup.py",
    "check:motion": "python tools/motion_check.py render/mv.mp4",
    "check:lyrics": "node tools/check_no_lyrics.mjs",
    "lint": "node tools/lint.mjs",
    "storyboard": "node tools/storyboard.mjs",
    "check:shots": "node tools/check_shots.mjs",
    "check:pops": "node tools/pops.mjs",
    "check:sync": "python tools/check_sync.py render/mv.mp4",
    "sheet:cues": "node tools/cues_sheet.mjs",
    "regress:snap": "node tools/regress.mjs snap",
    "regress:compare": "python tools/compare_sheets.py",
    "rig:test": "node tools/rig_selftest.mjs"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
